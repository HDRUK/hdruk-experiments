{
    "name": "@hdruk/experiments",
    "version": "0.1.0",
    "description": "Targeted in-app feedback prompts, design preference tests and the builder to make them",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HDRUK/hdruk-experiments.git"
    },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js",
            "require": "./dist/client.cjs"
        },
        "./builder": {
            "types": "./dist/builder.d.ts",
            "import": "./dist/builder.js",
            "require": "./dist/builder.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "dev:link": "YALC_PUSH=1 tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build",
        "format": "prettier --write \"src/**/*.{ts,tsx}\""
    },
    "peerDependencies": {
        "@dnd-kit/core": "^6.1.0",
        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@mui/icons-material": "^7.3.2",
        "@mui/material": "^7.3.2",
        "@mui/utils": "^7.3.2",
        "@tiptap/extension-link": "^2.6.6",
        "@tiptap/extension-underline": "^2.6.6",
        "@tiptap/react": "^2.6.6",
        "@tiptap/starter-kit": "^2.6.6",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@dnd-kit/core": {
            "optional": true
        },
        "@dnd-kit/sortable": {
            "optional": true
        },
        "@dnd-kit/utilities": {
            "optional": true
        }
    },
    "devDependencies": {
        "@dnd-kit/core": "^6.1.0",
        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^7.3.5",
        "@mui/material": "^7.3.5",
        "@mui/system": "^7.3.5",
        "@mui/utils": "^7.3.5",
        "@mui/x-date-pickers": "^8.29.4",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@tiptap/extension-link": "^2.6.6",
        "@tiptap/extension-underline": "^2.6.6",
        "@tiptap/pm": "^2.6.6",
        "@tiptap/react": "^2.6.6",
        "@tiptap/starter-kit": "^2.6.6",
        "@trivago/prettier-plugin-sort-imports": "^4.3.0",
        "@types/node": "^24.10.1",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "jsdom": "^26.1.0",
        "prettier": "^2.8.7",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "tsup": "^8.5.0",
        "typescript": "5.9.3",
        "vitest": "^5.1.0"
    }
}
